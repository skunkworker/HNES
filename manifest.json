{
    "name": "Hacker News Enhancement Suite",
    "short_name": "HNES",
    "version": "2.0.0",
    "description": "Hacker News Enhanced.",
    "manifest_version": 3,
    "minimum_chrome_version": "123",
    "background": {
      "service_worker": "background.js",
      "scripts": ["background.js"]
    },
    "permissions": [
      "storage",
      "unlimitedStorage",
      "offscreen"
    ],
    "icons": {
        "16" : "images/icon-16.png",
        "48" : "images/icon-48.png",
        "128" : "images/icon-128.png"
    },
    "content_scripts": [
      { "run_at": "document_start",
        "css": [ "style.css" ],
        "js": [ "js/boot.js" ],
        "matches": [
          "https://news.ycombinator.com/*",
          "https://hackerne.ws/*"]
      },
      {
        "run_at": "document_end",
        "js": [
          "js/jquery-3.2.1.min.js",
          "js/linkify/jquery.linkify-1.0.js",
          "js/linkify/plugins/jquery.linkify-1.0-twitter.js",
          "js/hn.js"],
        "matches": [
          "https://news.ycombinator.com/*",
          "https://hackerne.ws/*"]
      },
      {
        "matches": ["https://hckrnews.com/*"],
        "run_at": "document_end",
        "js": ["js/jquery-3.2.1.min.js", "js/hn.js"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "images/spin.gif",
          "images/unvote.gif",
          "images/tag.svg"
        ],
        "matches": [
          "https://news.ycombinator.com/*",
          "https://hackerne.ws/*"
        ]
      }
    ]
}
